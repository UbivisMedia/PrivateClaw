{
  "version": 1,
  "steps": [
    {
      "id": "setze_roman_titel",
      "type": "tool",
      "name": "Romantitel als Variable setzen",
      "config": {
        "tool": "variables.set",
        "name": "roman_titel",
        "value_type": "string",
        "operation": "set",
        "value": "Das Archiv unter dem Eis",
        "output": "roman_titel_status"
      }
    },
    {
      "id": "setze_roman_slug",
      "type": "tool",
      "name": "Dateisicheren Roman-Slug setzen",
      "config": {
        "tool": "variables.set",
        "name": "roman_slug",
        "value_type": "string",
        "operation": "set",
        "value": "das_archiv_unter_dem_eis",
        "output": "roman_slug_status"
      }
    },
    {
      "id": "setze_roman_praemisse",
      "type": "tool",
      "name": "Praemisse als Variable setzen",
      "config": {
        "tool": "variables.set",
        "name": "roman_praemisse",
        "value_type": "string",
        "operation": "set",
        "value": "In einer arktischen Forschungsstation entdeckt eine junge Linguistin ein Archiv aus Eis, das Erinnerungen fremder Zivilisationen speichert und damit einen politischen Wettlauf um Wahrheit, Macht und Identitaet ausloest.",
        "output": "roman_praemisse_status"
      }
    },
    {
      "id": "setze_szenen_pro_kapitel",
      "type": "tool",
      "name": "Szenen pro Kapitel definieren",
      "config": {
        "tool": "variables.set",
        "name": "szenen_pro_kapitel",
        "value_type": "int",
        "operation": "set",
        "value": "3",
        "output": "szenen_pro_kapitel_status"
      }
    },
    {
      "id": "pruefe_kapitelvariable",
      "type": "decision",
      "name": "Kapitelnummer bereits als Projektvariable vorhanden?",
      "config": {
        "input": "{{project_var.kapitel_nummer}}",
        "operator": "not_empty",
        "output": "kapitel_nummer_status",
        "true_result": "vorhanden",
        "false_result": "initialisieren",
        "if_true": "pruefe_szenenvariable"
      }
    },
    {
      "id": "initialisiere_kapitelvariable",
      "type": "tool",
      "name": "Kapitelnummer projektweit initialisieren",
      "config": {
        "tool": "variables.set",
        "scope": "project",
        "name": "kapitel_nummer",
        "value_type": "int",
        "operation": "set",
        "value": "1",
        "output": "kapitel_nummer_status"
      }
    },
    {
      "id": "pruefe_szenenvariable",
      "type": "decision",
      "name": "Szenennummer bereits als Projektvariable vorhanden?",
      "config": {
        "input": "{{project_var.szenen_nummer}}",
        "operator": "not_empty",
        "output": "szenen_nummer_status",
        "true_result": "vorhanden",
        "false_result": "initialisieren",
        "if_true": "suche_hauptcharakter_memory"
      }
    },
    {
      "id": "initialisiere_szenenvariable",
      "type": "tool",
      "name": "Szenennummer projektweit initialisieren",
      "config": {
        "tool": "variables.set",
        "scope": "project",
        "name": "szenen_nummer",
        "value_type": "int",
        "operation": "set",
        "value": "1",
        "output": "szenen_nummer_status"
      }
    },
    {
      "id": "suche_hauptcharakter_memory",
      "type": "tool",
      "name": "Vorhandene Hauptcharaktere suchen",
      "config": {
        "tool": "memory.search",
        "query": "",
        "entry_type": "character",
        "tags": "roman,{{roman_slug}},figuren,hauptcharaktere",
        "limit": 6,
        "max_chars": 8000,
        "format": "full",
        "output": "hauptcharaktere_memory"
      }
    },
    {
      "id": "hauptcharaktere_vorhanden",
      "type": "decision",
      "name": "Hauptcharaktere bereits vorhanden?",
      "config": {
        "input": "{{hauptcharaktere_memory}}",
        "operator": "not_empty",
        "output": "hauptcharaktere_status",
        "true_result": "vorhanden",
        "false_result": "anlegen",
        "if_true": "lade_story_kontext"
      }
    },
    {
      "id": "plane_hauptcharaktere_json",
      "type": "prompt",
      "name": "Hauptcharaktere fuer Neustart planen",
      "config": {
        "prompt": "Erstelle fuer den Roman \"{{roman_titel}}\" eine belastbare Startliste der Hauptfiguren.\n\nPraemisse:\n{{roman_praemisse}}\n\nGib ausschliesslich JSON als Array zurueck. Maximal 6 Eintraege. Jeder Eintrag braucht diese String-Felder:\n- name\n- rolle\n- inneres_ziel\n- aeusseres_ziel\n- konflikt\n- stimme\n- geheimnis\n\nKein Markdown. Kein ```json. Kein Begleittext.\n\nBeispiel:\n[\n  {\n    \"name\": \"Mira\",\n    \"rolle\": \"Linguistin\",\n    \"inneres_ziel\": \"...\",\n    \"aeusseres_ziel\": \"...\",\n    \"konflikt\": \"...\",\n    \"stimme\": \"...\",\n    \"geheimnis\": \"...\"\n  }\n]",
        "output": "hauptcharaktere_seed_json"
      }
    },
    {
      "id": "erzeuge_hauptcharaktere",
      "type": "tool",
      "name": "Hauptcharaktere einzeln ausarbeiten",
      "config": {
        "tool": "workflow.foreach",
        "items": "{{hauptcharaktere_seed_json}}",
        "item_var": "figur",
        "index_var": "figur_index",
        "result_mode": "text_joined",
        "result_source": "{{figur_steckbrief}}",
        "join_with": "\n\n---\n\n",
        "max_iterations": 6,
        "on_error": "abort",
        "output": "hauptcharaktere_dossier",
        "steps": [
          {
            "id": "arbeite_figur_aus",
            "type": "prompt",
            "name": "Hauptfigur ausarbeiten",
            "config": {
              "prompt": "Arbeite die Hauptfigur fuer den Roman \"{{roman_titel}}\" praezise aus.\n\nStartdaten:\n- Name: {{figur.name}}\n- Rolle: {{figur.rolle}}\n- Inneres Ziel: {{figur.inneres_ziel}}\n- Aeusseres Ziel: {{figur.aeusseres_ziel}}\n- Konflikt: {{figur.konflikt}}\n- Stimme: {{figur.stimme}}\n- Geheimnis: {{figur.geheimnis}}\n\nLiefere eine kompakte, aber spaeter gut zitierbare Charakterkarte mit diesen Feldern:\n- Name\n- Rolle in der Geschichte\n- Inneres Ziel\n- Aeusseres Ziel\n- Zentraler Konflikt\n- Praegende Stimme oder Haltung\n- Geheimnis oder Verletzlichkeit\n- Beziehungspotenzial zu den anderen Hauptfiguren",
              "output": "figur_steckbrief"
            }
          },
          {
            "id": "speichere_figur_memory",
            "type": "save_memory",
            "name": "Hauptfigur sichern",
            "config": {
              "content": "Hauptfigur fuer {{roman_titel}}:\n\n{{figur_steckbrief}}",
              "entry_type": "character",
              "source": "workflow:buchautor_szene/hauptcharaktere",
              "tags": "roman,{{roman_slug}},figuren,hauptcharaktere,{{figur.name}}",
              "relevance": 95,
              "pinned": true
            }
          }
        ]
      }
    },
    {
      "id": "lade_story_kontext",
      "type": "tool",
      "name": "Figuren-, Orts- und Plotkontext laden",
      "config": {
        "tool": "memory.search",
        "query": "",
        "tags": "roman,{{roman_slug}}",
        "limit": 18,
        "max_chars": 22000,
        "format": "full",
        "output": "story_kontext"
      }
    },
    {
      "id": "setze_kapitel_szene_label",
      "type": "tool",
      "name": "Kapitel-Szenen-Label setzen",
      "config": {
        "tool": "variables.set",
        "name": "kapitel_szene_label",
        "value_type": "string",
        "operation": "set",
        "value": "{{roman_titel}} - Kapitel {{kapitel_nummer}}, Szene {{szenen_nummer}}",
        "output": "kapitel_szene_label_status"
      }
    },
    {
      "id": "setze_szene_dateipfad",
      "type": "tool",
      "name": "Dateipfad fuer Szene setzen",
      "config": {
        "tool": "variables.set",
        "name": "szene_dateipfad",
        "value_type": "string",
        "operation": "set",
        "value": "artifacts/roman/{{roman_slug}}/kapitel_{{kapitel_nummer}}/szene_{{szenen_nummer}}.md",
        "output": "szene_dateipfad_status"
      }
    },
    {
      "id": "plane_szenenbeats_json",
      "type": "prompt",
      "name": "Szenenbeats planen",
      "config": {
        "prompt": "Projekt: {{roman_titel}}\nPraemisse: {{roman_praemisse}}\nAktueller Abschnitt: {{kapitel_szene_label}}\n\nBisheriger Kontext aus dem Gedaechtnis:\n{{story_kontext}}\n\nPlane die naechste Szene in 3 bis 5 klaren Beats. Gib ausschliesslich JSON als Array zurueck. Jeder Beat braucht diese String-Felder:\n- beat_titel\n- ziel\n- konflikt\n- wendung\n- fokusfigur\n- ort\n\nKein Markdown. Kein ```json. Kein Begleittext.\nDie Szene soll auf spaetere Extraktionen fuer Figuren, Orte und Ereignisse optimiert sein.",
        "output": "szenenbeats_json"
      }
    },
    {
      "id": "schreibe_szene_absatzweise",
      "type": "tool",
      "name": "Szene beatweise schreiben",
      "config": {
        "tool": "workflow.foreach",
        "items": "{{szenenbeats_json}}",
        "item_var": "beat",
        "index_var": "beat_index",
        "result_mode": "text_joined",
        "result_source": "{{beat_abschnitt}}",
        "join_with": "\n\n",
        "max_iterations": 8,
        "on_error": "abort",
        "output": "neue_szene",
        "steps": [
          {
            "id": "schreibe_beat_abschnitt",
            "type": "prompt",
            "name": "Beat in Romantext umsetzen",
            "config": {
              "prompt": "Schreibe den naechsten Abschnitt fuer die Szene \"{{kapitel_szene_label}}\".\n\nGesamtkontext:\n{{story_kontext}}\n\nAktueller Beat:\n- Titel: {{beat.beat_titel}}\n- Ziel: {{beat.ziel}}\n- Konflikt: {{beat.konflikt}}\n- Wendung: {{beat.wendung}}\n- Fokusfigur: {{beat.fokusfigur}}\n- Ort: {{beat.ort}}\n\nVorheriger direkt geschriebener Absatz:\n{{loop_prev_output}}\n\nRegeln:\n- schreibe nur den naechsten zusammenhaengenden Abschnitt fuer diesen Beat\n- aktive Darstellung statt Erklaertext\n- glaubwuerdige Dialoge mit Subtext, falls passend\n- fuehre neue Figuren, Orte oder plotrelevante Ereignisse klar benennbar ein\n- keine Ueberschriften, keine Vorrede",
              "output": "beat_abschnitt"
            }
          }
        ]
      }
    },
    {
      "id": "speichere_szene_memory",
      "type": "save_memory",
      "name": "Szene im Projektgedaechtnis sichern",
      "config": {
        "content": "{{kapitel_szene_label}}\n\n{{neue_szene}}",
        "entry_type": "artifact",
        "source": "workflow:buchautor_szene/szene",
        "tags": "roman,{{roman_slug}},szene,kapitel",
        "relevance": 90
      }
    },
    {
      "id": "exportiere_szene_datei",
      "type": "tool",
      "name": "Szene als Datei exportieren",
      "config": {
        "tool": "file.write_text",
        "path": "{{szene_dateipfad}}",
        "mode": "overwrite",
        "create_dirs": true,
        "content": "# {{kapitel_szene_label}}\n\n{{neue_szene}}",
        "return_content": false,
        "output": "export_ergebnis"
      }
    },
    {
      "id": "analysiere_nebencharaktere_json",
      "type": "prompt",
      "name": "Nebencharaktere als JSON extrahieren",
      "config": {
        "prompt": "Vergleiche die neue Szene mit dem bisherigen Story-Kontext.\n\nKontext:\n{{story_kontext}}\n\nSzene:\n{{neue_szene}}\n\nGib ausschliesslich JSON als Array zurueck. Liefere nur neue oder deutlich veraenderte Nebencharaktere. Jeder Eintrag braucht diese String-Felder:\n- name\n- rolle\n- erster_eindruck\n- motivation\n- beziehung\n- story_relevanz\n\nWenn nichts Relevantes auftaucht, gib [] zurueck.\nKein Markdown. Kein ```json. Kein Begleittext.",
        "output": "nebencharaktere_json"
      }
    },
    {
      "id": "speichere_nebencharaktere_geziehlt",
      "type": "tool",
      "name": "Nebencharaktere einzeln sichern",
      "config": {
        "tool": "workflow.foreach",
        "items": "{{nebencharaktere_json}}",
        "item_var": "nebenfigur",
        "index_var": "nebenfigur_index",
        "result_mode": "text_joined",
        "result_source": "{{last_memory_content}}",
        "join_with": "\n\n",
        "max_iterations": 10,
        "on_error": "continue",
        "output": "nebencharaktere_resultat",
        "steps": [
          {
            "id": "speichere_nebenfigur_memory",
            "type": "save_memory",
            "name": "Nebencharakter speichern",
            "config": {
              "content": "Nebencharakter in {{kapitel_szene_label}}:\n- Name: {{nebenfigur.name}}\n- Rolle: {{nebenfigur.rolle}}\n- Erster Eindruck: {{nebenfigur.erster_eindruck}}\n- Motivation oder Konflikt: {{nebenfigur.motivation}}\n- Beziehung zu Hauptfiguren: {{nebenfigur.beziehung}}\n- Story-Relevanz: {{nebenfigur.story_relevanz}}",
              "entry_type": "character",
              "source": "workflow:buchautor_szene/nebencharaktere",
              "tags": "roman,{{roman_slug}},figuren,nebencharaktere,{{nebenfigur.name}}",
              "relevance": 84
            }
          }
        ]
      }
    },
    {
      "id": "analysiere_orte_json",
      "type": "prompt",
      "name": "Orte als JSON extrahieren",
      "config": {
        "prompt": "Vergleiche die neue Szene mit dem bisherigen Story-Kontext.\n\nKontext:\n{{story_kontext}}\n\nSzene:\n{{neue_szene}}\n\nGib ausschliesslich JSON als Array zurueck. Liefere nur neue oder deutlich weiterentwickelte Orte. Jeder Eintrag braucht diese String-Felder:\n- name\n- funktion\n- atmosphaere\n- details\n- konsequenzen\n\nWenn nichts Relevantes auftaucht, gib [] zurueck.\nKein Markdown. Kein ```json. Kein Begleittext.",
        "output": "orte_json"
      }
    },
    {
      "id": "speichere_orte_geziehlt",
      "type": "tool",
      "name": "Orte einzeln sichern",
      "config": {
        "tool": "workflow.foreach",
        "items": "{{orte_json}}",
        "item_var": "ort",
        "index_var": "ort_index",
        "result_mode": "text_joined",
        "result_source": "{{last_memory_content}}",
        "join_with": "\n\n",
        "max_iterations": 10,
        "on_error": "continue",
        "output": "orte_resultat",
        "steps": [
          {
            "id": "speichere_ort_memory",
            "type": "save_memory",
            "name": "Ort speichern",
            "config": {
              "content": "Ort in {{kapitel_szene_label}}:\n- Name oder Bezeichnung: {{ort.name}}\n- Funktion in der Szene: {{ort.funktion}}\n- Atmosphaere: {{ort.atmosphaere}}\n- Relevante Details: {{ort.details}}\n- Moegliche Konsequenzen fuer spaetere Szenen: {{ort.konsequenzen}}",
              "entry_type": "location",
              "source": "workflow:buchautor_szene/orte",
              "tags": "roman,{{roman_slug}},orte,schauplaetze,{{ort.name}}",
              "relevance": 82
            }
          }
        ]
      }
    },
    {
      "id": "analysiere_ereignisse_json",
      "type": "prompt",
      "name": "Plotrelevante Ereignisse als JSON extrahieren",
      "config": {
        "prompt": "Vergleiche die neue Szene mit dem bisherigen Story-Kontext.\n\nKontext:\n{{story_kontext}}\n\nSzene:\n{{neue_szene}}\n\nGib ausschliesslich JSON als Array zurueck. Liefere nur neue plotrelevante Ereignisse. Jeder Eintrag braucht diese String-Felder:\n- ereignis\n- direkte_auswirkung\n- betroffene_figuren\n- spaetere_folgen\n\nWenn nichts Relevantes auftaucht, gib [] zurueck.\nKein Markdown. Kein ```json. Kein Begleittext.",
        "output": "ereignisse_json"
      }
    },
    {
      "id": "speichere_ereignisse_geziehlt",
      "type": "tool",
      "name": "Ereignisse einzeln sichern",
      "config": {
        "tool": "workflow.foreach",
        "items": "{{ereignisse_json}}",
        "item_var": "ereignis",
        "index_var": "ereignis_index",
        "result_mode": "text_joined",
        "result_source": "{{last_memory_content}}",
        "join_with": "\n\n",
        "max_iterations": 10,
        "on_error": "continue",
        "output": "ereignisse_resultat",
        "steps": [
          {
            "id": "speichere_ereignis_memory",
            "type": "save_memory",
            "name": "Ereignis speichern",
            "config": {
              "content": "Plotrelevantes Ereignis in {{kapitel_szene_label}}:\n- Ereignis: {{ereignis.ereignis}}\n- Direkte Auswirkung: {{ereignis.direkte_auswirkung}}\n- Betroffene Figuren: {{ereignis.betroffene_figuren}}\n- Moegliche spaetere Folgen: {{ereignis.spaetere_folgen}}",
              "entry_type": "event",
              "source": "workflow:buchautor_szene/ereignisse",
              "tags": "roman,{{roman_slug}},ereignisse,plot",
              "relevance": 88
            }
          }
        ]
      }
    },
    {
      "id": "erstelle_lektorat",
      "type": "prompt",
      "name": "Lektorats-Feedback generieren",
      "config": {
        "prompt": "Analysiere die folgende Szene als erfahrener Lektor. Gib vier klar getrennte Abschnitte:\n\nStaerken\nSchwaechen\nKonkrete Verbesserungsvorschlaege\nOffene Baustellen\n\nSzene:\n{{neue_szene}}",
        "output": "lektorat_feedback"
      }
    },
    {
      "id": "speichere_lektorat",
      "type": "save_memory",
      "name": "Lektorats-Feedback speichern",
      "config": {
        "content": "Lektorats-Feedback zu {{kapitel_szene_label}}:\n\n{{lektorat_feedback}}",
        "entry_type": "note",
        "source": "workflow:buchautor_szene/lektorat",
        "tags": "roman,{{roman_slug}},lektorat,feedback",
        "relevance": 70
      }
    },
    {
      "id": "extrahiere_baustellen",
      "type": "prompt",
      "name": "Offene Baustellen verdichten",
      "config": {
        "prompt": "Verdichte aus Szene und Lektorats-Feedback die offenen Baustellen fuer die naechsten Szenen. Liefere maximal 8 praezise Stichpunkte.\n\nSzene:\n{{neue_szene}}\n\nLektorats-Feedback:\n{{lektorat_feedback}}",
        "output": "offene_baustellen"
      }
    },
    {
      "id": "speichere_offene_baustellen",
      "type": "save_memory",
      "name": "Offene Baustellen festhalten",
      "config": {
        "content": "Offene Baustellen nach {{kapitel_szene_label}}:\n\n{{offene_baustellen}}",
        "entry_type": "note",
        "source": "workflow:buchautor_szene/baustellen",
        "tags": "roman,{{roman_slug}},todo,baustellen",
        "relevance": 86,
        "pinned": true
      }
    },
    {
      "id": "erhoehe_szenen_nummer",
      "type": "tool",
      "name": "Szenenzaehler fuer den naechsten Lauf erhoehen",
      "config": {
        "tool": "variables.set",
        "scope": "project",
        "name": "szenen_nummer",
        "value_type": "int",
        "operation": "increment",
        "current_value": "{{szenen_nummer}}",
        "amount": 1,
        "output": "naechste_szenen_nummer_status"
      }
    },
    {
      "id": "pruefe_kapitelwechsel",
      "type": "decision",
      "name": "Kapitelwechsel pruefen",
      "config": {
        "input": "{{szenen_nummer}}",
        "operator": "greater_than",
        "value": "{{szenen_pro_kapitel}}",
        "output": "kapitelwechsel_status",
        "true_result": "neues_kapitel",
        "false_result": "gleiches_kapitel",
        "if_true": "erhoehe_kapitel_nummer",
        "if_false": "setze_fortschritt_status"
      }
    },
    {
      "id": "erhoehe_kapitel_nummer",
      "type": "tool",
      "name": "Kapitelzaehler erhoehen",
      "config": {
        "tool": "variables.set",
        "scope": "project",
        "name": "kapitel_nummer",
        "value_type": "int",
        "operation": "increment",
        "current_value": "{{kapitel_nummer}}",
        "amount": 1,
        "output": "naechste_kapitel_nummer_status"
      }
    },
    {
      "id": "setze_szenennummer_zurueck",
      "type": "tool",
      "name": "Szenennummer fuer neues Kapitel resetten",
      "config": {
        "tool": "variables.set",
        "scope": "project",
        "name": "szenen_nummer",
        "value_type": "int",
        "operation": "set",
        "value": "1",
        "output": "reset_szenen_nummer_status"
      }
    },
    {
      "id": "setze_fortschritt_status",
      "type": "tool",
      "name": "Naechsten Fortschritt als Laufvariable zusammenfassen",
      "config": {
        "tool": "variables.set",
        "name": "fortschritt_status",
        "value_type": "string",
        "operation": "set",
        "value": "Naechster Lauf startet mit Kapitel {{kapitel_nummer}}, Szene {{szenen_nummer}}.",
        "output": "fortschritt_status"
      }
    }
  ]
}
