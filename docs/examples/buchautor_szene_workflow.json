{
  "version": 1,
  "steps": [
    {
      "id": "setze_roman_titel",
      "type": "tool",
      "name": "Romantitel als Variable setzen",
      "config": {
        "tool": "variables.set",
        "name": "roman_titel",
        "value_type": "string",
        "operation": "set",
        "value": "Das Archiv unter dem Eis",
        "output": "roman_titel_status"
      }
    },
    {
      "id": "setze_roman_slug",
      "type": "tool",
      "name": "Dateisicheren Roman-Slug setzen",
      "config": {
        "tool": "variables.set",
        "name": "roman_slug",
        "value_type": "string",
        "operation": "set",
        "value": "das_archiv_unter_dem_eis",
        "output": "roman_slug_status"
      }
    },
    {
      "id": "setze_roman_praemisse",
      "type": "tool",
      "name": "Praemisse als Variable setzen",
      "config": {
        "tool": "variables.set",
        "name": "roman_praemisse",
        "value_type": "string",
        "operation": "set",
        "value": "In einer arktischen Forschungsstation entdeckt eine junge Linguistin ein Archiv aus Eis, das Erinnerungen fremder Zivilisationen speichert und damit einen politischen Wettlauf um Wahrheit, Macht und Identitaet ausloest.",
        "output": "roman_praemisse_status"
      }
    },
    {
      "id": "setze_szenen_pro_kapitel",
      "type": "tool",
      "name": "Szenen pro Kapitel definieren",
      "config": {
        "tool": "variables.set",
        "name": "szenen_pro_kapitel",
        "value_type": "int",
        "operation": "set",
        "value": "3",
        "output": "szenen_pro_kapitel_status"
      }
    },
    {
      "id": "lade_fortschritt_memory",
      "type": "tool",
      "name": "Letzten Schreibfortschritt laden",
      "config": {
        "tool": "memory.search",
        "query": "Workflow Fortschritt Kapitel Szene {{roman_titel}}",
        "entry_type": "note",
        "tags": "roman,{{roman_slug}},fortschritt,workflow",
        "limit": 1,
        "max_chars": 4000,
        "format": "full",
        "output": "fortschritt_memory"
      }
    },
    {
      "id": "normalisiere_fortschritt",
      "type": "prompt",
      "name": "Fortschritt als JSON normalisieren",
      "config": {
        "prompt": "Du bekommst den zuletzt gespeicherten Workflow-Fortschritt fuer einen Roman. Extrahiere die beiden Integerwerte fuer Kapitel und Szene. Falls kein brauchbarer Fortschritt vorhanden ist, setze beide Werte auf 1.\n\nGib ausschliesslich JSON im Format {\"kapitel_nummer\":1,\"szenen_nummer\":1} zurueck.\n\nRoman: {{roman_titel}}\nMemory:\n{{fortschritt_memory}}",
        "output": "fortschritt_json"
      }
    },
    {
      "id": "extrahiere_kapitel_nummer",
      "type": "tool",
      "name": "Kapitelnummer aus JSON lesen",
      "config": {
        "tool": "json.extract",
        "input": "{{fortschritt_json}}",
        "path": "kapitel_nummer",
        "pretty": false,
        "output": "fortschritt_kapitel_nummer"
      }
    },
    {
      "id": "speichere_kapitel_nummer",
      "type": "tool",
      "name": "Kapitelnummer als Integer setzen",
      "config": {
        "tool": "variables.set",
        "name": "kapitel_nummer",
        "value_type": "int",
        "operation": "set",
        "value": "{{fortschritt_kapitel_nummer}}",
        "output": "kapitel_nummer_status"
      }
    },
    {
      "id": "extrahiere_szenen_nummer",
      "type": "tool",
      "name": "Szenennummer aus JSON lesen",
      "config": {
        "tool": "json.extract",
        "input": "{{fortschritt_json}}",
        "path": "szenen_nummer",
        "pretty": false,
        "output": "fortschritt_szenen_nummer"
      }
    },
    {
      "id": "speichere_szenen_nummer",
      "type": "tool",
      "name": "Szenennummer als Integer setzen",
      "config": {
        "tool": "variables.set",
        "name": "szenen_nummer",
        "value_type": "int",
        "operation": "set",
        "value": "{{fortschritt_szenen_nummer}}",
        "output": "szenen_nummer_status"
      }
    },
    {
      "id": "suche_hauptcharakter_memory",
      "type": "tool",
      "name": "Vorhandene Hauptcharaktere suchen",
      "config": {
        "tool": "memory.search",
        "query": "Hauptcharaktere Protagonisten Ensemble {{roman_titel}}",
        "entry_type": "character",
        "tags": "roman,{{roman_slug}},figuren,hauptcharaktere",
        "limit": 3,
        "max_chars": 6000,
        "format": "full",
        "output": "hauptcharaktere_memory"
      }
    },
    {
      "id": "hauptcharaktere_vorhanden",
      "type": "decision",
      "name": "Hauptcharaktere bereits vorhanden?",
      "config": {
        "input": "{{hauptcharaktere_memory}}",
        "operator": "not_empty",
        "output": "hauptcharaktere_status",
        "true_result": "vorhanden",
        "false_result": "anlegen",
        "if_true": "lade_story_kontext"
      }
    },
    {
      "id": "erstelle_hauptcharaktere",
      "type": "prompt",
      "name": "Hauptcharaktere fuer Neustart anlegen",
      "config": {
        "prompt": "Erstelle eine kompakte, aber belastbare Charakterbibel fuer die Hauptcharaktere des Romans \"{{roman_titel}}\".\n\nPraemisse:\n{{roman_praemisse}}\n\nLiefere fuer jede Hauptfigur diese Felder:\n- Name\n- Rolle in der Geschichte\n- Inneres Ziel\n- Aeusseres Ziel\n- Zentraler Konflikt\n- Praegende Stimme oder Haltung\n- Geheimnis oder Verletzlichkeit\n- Beziehung zu den anderen Hauptfiguren\n\nMaximal 6 Figuren. Schreibe praezise und spaeter gut zitierbar.",
        "output": "hauptcharaktere_dossier"
      }
    },
    {
      "id": "speichere_hauptcharaktere_memory",
      "type": "save_memory",
      "name": "Hauptcharaktere persistent sichern",
      "config": {
        "content": "Hauptcharaktere fuer {{roman_titel}}:\n\n{{hauptcharaktere_dossier}}",
        "entry_type": "character",
        "source": "workflow:buchautor_szene/hauptcharaktere",
        "tags": "roman,{{roman_slug}},figuren,hauptcharaktere",
        "relevance": 95,
        "pinned": true
      }
    },
    {
      "id": "lade_story_kontext",
      "type": "tool",
      "name": "Figuren-, Orts- und Plotkontext laden",
      "config": {
        "tool": "memory.search",
        "query": "{{roman_titel}} Hauptcharaktere Nebencharaktere Orte Ereignisse Konflikte Baustellen",
        "tags": "roman,{{roman_slug}}",
        "limit": 12,
        "max_chars": 18000,
        "format": "full",
        "output": "story_kontext"
      }
    },
    {
      "id": "setze_kapitel_szene_label",
      "type": "tool",
      "name": "Kapitel-Szenen-Label setzen",
      "config": {
        "tool": "variables.set",
        "name": "kapitel_szene_label",
        "value_type": "string",
        "operation": "set",
        "value": "{{roman_titel}} - Kapitel {{kapitel_nummer}}, Szene {{szenen_nummer}}",
        "output": "kapitel_szene_label_status"
      }
    },
    {
      "id": "setze_szene_dateipfad",
      "type": "tool",
      "name": "Dateipfad fuer Szene setzen",
      "config": {
        "tool": "variables.set",
        "name": "szene_dateipfad",
        "value_type": "string",
        "operation": "set",
        "value": "artifacts/roman/{{roman_slug}}/kapitel_{{kapitel_nummer}}/szene_{{szenen_nummer}}.md",
        "output": "szene_dateipfad_status"
      }
    },
    {
      "id": "schreibe_szene",
      "type": "prompt",
      "name": "Naechste Szene schreiben",
      "config": {
        "prompt": "Projekt: {{roman_titel}}\nPraemisse: {{roman_praemisse}}\nAktueller Abschnitt: {{kapitel_szene_label}}\n\nBisheriger Kontext aus dem Gedaechtnis:\n{{story_kontext}}\n\nSchreibe jetzt die naechste Roman-Szene. Achte auf:\n- Konsistenz mit bereits bekannten Figuren, Orten und Konflikten\n- klare Ziel-, Hindernis- und Veraenderungsdynamik innerhalb der Szene\n- aktive Darstellung statt Erklaertext\n- glaubwuerdige Dialoge mit Subtext\n- eine konkrete Entwicklung, die spaeter als Memory festgehalten werden kann\n\nWenn neue Nebenfiguren, Orte oder plotrelevante Ereignisse auftauchen, fuehre sie so klar ein, dass sie spaeter separat extrahiert werden koennen.\n\nLiefere nur den Romantext ohne Vorrede.",
        "output": "neue_szene"
      }
    },
    {
      "id": "speichere_szene_memory",
      "type": "save_memory",
      "name": "Szene im Projektgedaechtnis sichern",
      "config": {
        "content": "{{kapitel_szene_label}}\n\n{{neue_szene}}",
        "entry_type": "artifact",
        "source": "workflow:buchautor_szene/szene",
        "tags": "roman,{{roman_slug}},szene,kapitel",
        "relevance": 90
      }
    },
    {
      "id": "exportiere_szene_datei",
      "type": "tool",
      "name": "Szene als Datei exportieren",
      "config": {
        "tool": "file.write_text",
        "path": "{{szene_dateipfad}}",
        "mode": "overwrite",
        "create_dirs": true,
        "content": "# {{kapitel_szene_label}}\n\n{{neue_szene}}",
        "return_content": false,
        "output": "export_ergebnis"
      }
    },
    {
      "id": "analysiere_nebencharaktere",
      "type": "prompt",
      "name": "Neue Nebencharaktere extrahieren",
      "config": {
        "prompt": "Vergleiche die neue Szene mit dem bisherigen Story-Kontext.\n\nKontext:\n{{story_kontext}}\n\nSzene:\n{{neue_szene}}\n\nFalls neue oder deutlich veraenderte Nebencharaktere auftauchen, liefere fuer jede Figur einen eigenen Block mit:\n- Name\n- Rolle\n- erster Eindruck\n- Motivation oder Konflikt\n- Beziehung zu Hauptfiguren\n- Story-Relevanz\n\nWenn nichts Neues oder Relevantes dabei ist, antworte exakt mit NONE.",
        "output": "nebencharaktere_update"
      }
    },
    {
      "id": "sind_nebencharaktere_relevant",
      "type": "decision",
      "name": "Nebencharaktere nur bei Bedarf speichern",
      "config": {
        "input": "{{nebencharaktere_update}}",
        "operator": "not_equals",
        "value": "NONE",
        "output": "nebencharaktere_status",
        "true_result": "speichern",
        "false_result": "ueberspringen",
        "if_true": "speichere_nebencharaktere_memory",
        "if_false": "analysiere_orte"
      }
    },
    {
      "id": "speichere_nebencharaktere_memory",
      "type": "save_memory",
      "name": "Nebencharaktere sichern",
      "config": {
        "content": "Neue oder veraenderte Nebencharaktere in {{kapitel_szene_label}}:\n\n{{nebencharaktere_update}}",
        "entry_type": "character",
        "source": "workflow:buchautor_szene/nebencharaktere",
        "tags": "roman,{{roman_slug}},figuren,nebencharaktere",
        "relevance": 84
      }
    },
    {
      "id": "analysiere_orte",
      "type": "prompt",
      "name": "Neue Orte extrahieren",
      "config": {
        "prompt": "Vergleiche die neue Szene mit dem bisherigen Story-Kontext.\n\nKontext:\n{{story_kontext}}\n\nSzene:\n{{neue_szene}}\n\nFalls neue oder deutlich weiterentwickelte Orte, Raeumlichkeiten oder Schauplaetze auftauchen, liefere fuer jeden Ort einen eigenen Block mit:\n- Name oder Bezeichnung\n- Funktion in der Szene\n- Atmosphaere\n- relevante Details\n- moegliche Konsequenzen fuer spaetere Szenen\n\nWenn nichts Neues oder Relevantes dabei ist, antworte exakt mit NONE.",
        "output": "orte_update"
      }
    },
    {
      "id": "sind_orte_relevant",
      "type": "decision",
      "name": "Orte nur bei Bedarf speichern",
      "config": {
        "input": "{{orte_update}}",
        "operator": "not_equals",
        "value": "NONE",
        "output": "orte_status",
        "true_result": "speichern",
        "false_result": "ueberspringen",
        "if_true": "speichere_orte_memory",
        "if_false": "analysiere_ereignisse"
      }
    },
    {
      "id": "speichere_orte_memory",
      "type": "save_memory",
      "name": "Orte sichern",
      "config": {
        "content": "Neue oder veraenderte Orte in {{kapitel_szene_label}}:\n\n{{orte_update}}",
        "entry_type": "location",
        "source": "workflow:buchautor_szene/orte",
        "tags": "roman,{{roman_slug}},orte,schauplaetze",
        "relevance": 82
      }
    },
    {
      "id": "analysiere_ereignisse",
      "type": "prompt",
      "name": "Plotrelevante Ereignisse extrahieren",
      "config": {
        "prompt": "Vergleiche die neue Szene mit dem bisherigen Story-Kontext.\n\nKontext:\n{{story_kontext}}\n\nSzene:\n{{neue_szene}}\n\nFalls die Szene neue plotrelevante Ereignisse, Enthuellungen, Entscheidungen, Verluste, Versprechen oder Konfliktverschiebungen enthaelt, liefere fuer jedes Ereignis einen eigenen Block mit:\n- Ereignis\n- direkte Auswirkung\n- betroffene Figuren\n- moegliche spaetere Folgen\n\nWenn nichts Neues oder Relevantes dabei ist, antworte exakt mit NONE.",
        "output": "ereignisse_update"
      }
    },
    {
      "id": "sind_ereignisse_relevant",
      "type": "decision",
      "name": "Ereignisse nur bei Bedarf speichern",
      "config": {
        "input": "{{ereignisse_update}}",
        "operator": "not_equals",
        "value": "NONE",
        "output": "ereignisse_status",
        "true_result": "speichern",
        "false_result": "ueberspringen",
        "if_true": "speichere_ereignisse_memory",
        "if_false": "erstelle_lektorat"
      }
    },
    {
      "id": "speichere_ereignisse_memory",
      "type": "save_memory",
      "name": "Ereignisse sichern",
      "config": {
        "content": "Neue plotrelevante Ereignisse in {{kapitel_szene_label}}:\n\n{{ereignisse_update}}",
        "entry_type": "event",
        "source": "workflow:buchautor_szene/ereignisse",
        "tags": "roman,{{roman_slug}},ereignisse,plot",
        "relevance": 88
      }
    },
    {
      "id": "erstelle_lektorat",
      "type": "prompt",
      "name": "Lektorats-Feedback generieren",
      "config": {
        "prompt": "Analysiere die folgende Szene als erfahrener Lektor. Gib vier klar getrennte Abschnitte:\n\nStaerken\nSchwaechen\nKonkrete Verbesserungsvorschlaege\nOffene Baustellen\n\nSzene:\n{{neue_szene}}",
        "output": "lektorat_feedback"
      }
    },
    {
      "id": "speichere_lektorat",
      "type": "save_memory",
      "name": "Lektorats-Feedback speichern",
      "config": {
        "content": "Lektorats-Feedback zu {{kapitel_szene_label}}:\n\n{{lektorat_feedback}}",
        "entry_type": "note",
        "source": "workflow:buchautor_szene/lektorat",
        "tags": "roman,{{roman_slug}},lektorat,feedback",
        "relevance": 70
      }
    },
    {
      "id": "extrahiere_baustellen",
      "type": "prompt",
      "name": "Offene Baustellen verdichten",
      "config": {
        "prompt": "Verdichte aus Szene und Lektorats-Feedback die offenen Baustellen fuer die naechsten Szenen. Liefere maximal 8 praezise Stichpunkte.\n\nSzene:\n{{neue_szene}}\n\nLektorats-Feedback:\n{{lektorat_feedback}}",
        "output": "offene_baustellen"
      }
    },
    {
      "id": "speichere_offene_baustellen",
      "type": "save_memory",
      "name": "Offene Baustellen festhalten",
      "config": {
        "content": "Offene Baustellen nach {{kapitel_szene_label}}:\n\n{{offene_baustellen}}",
        "entry_type": "note",
        "source": "workflow:buchautor_szene/baustellen",
        "tags": "roman,{{roman_slug}},todo,baustellen",
        "relevance": 86,
        "pinned": true
      }
    },
    {
      "id": "erhoehe_szenen_nummer",
      "type": "tool",
      "name": "Szenenzaehler fuer den naechsten Lauf erhoehen",
      "config": {
        "tool": "variables.set",
        "name": "szenen_nummer",
        "value_type": "int",
        "operation": "increment",
        "current_value": "{{szenen_nummer}}",
        "amount": 1,
        "output": "naechste_szenen_nummer_status"
      }
    },
    {
      "id": "pruefe_kapitelwechsel",
      "type": "decision",
      "name": "Kapitelwechsel pruefen",
      "config": {
        "input": "{{szenen_nummer}}",
        "operator": "greater_than",
        "value": "{{szenen_pro_kapitel}}",
        "output": "kapitelwechsel_status",
        "true_result": "neues_kapitel",
        "false_result": "gleiches_kapitel",
        "if_true": "erhoehe_kapitel_nummer",
        "if_false": "speichere_fortschritt_memory"
      }
    },
    {
      "id": "erhoehe_kapitel_nummer",
      "type": "tool",
      "name": "Kapitelzaehler erhoehen",
      "config": {
        "tool": "variables.set",
        "name": "kapitel_nummer",
        "value_type": "int",
        "operation": "increment",
        "current_value": "{{kapitel_nummer}}",
        "amount": 1,
        "output": "naechste_kapitel_nummer_status"
      }
    },
    {
      "id": "setze_szenennummer_zurueck",
      "type": "tool",
      "name": "Szenennummer fuer neues Kapitel resetten",
      "config": {
        "tool": "variables.set",
        "name": "szenen_nummer",
        "value_type": "int",
        "operation": "set",
        "value": "1",
        "output": "reset_szenen_nummer_status"
      }
    },
    {
      "id": "speichere_fortschritt_memory",
      "type": "save_memory",
      "name": "Fortschritt fuer den naechsten Lauf speichern",
      "config": {
        "content": "{\n  \"roman_titel\": \"{{roman_titel}}\",\n  \"kapitel_nummer\": {{kapitel_nummer}},\n  \"szenen_nummer\": {{szenen_nummer}},\n  \"szenen_pro_kapitel\": {{szenen_pro_kapitel}},\n  \"letzte_szene_label\": \"{{kapitel_szene_label}}\",\n  \"letzte_szene_datei\": \"{{szene_dateipfad}}\"\n}",
        "entry_type": "note",
        "source": "workflow:buchautor_szene/fortschritt",
        "tags": "roman,{{roman_slug}},fortschritt,workflow",
        "relevance": 96,
        "pinned": true
      }
    }
  ]
}
